# ---- Search: YepAPI SERP (primary detection source) ----
# Billed per CALL ($0.01), not per result — depth is nearly free coverage.
YEPAPI_API_KEY=

# ---- Search: Google Custom Search (fallback only) ----
# Google is discontinuing the Custom Search JSON API in January 2027.
# Requires "Custom Search API" enabled in the Cloud project.
GOOGLE_CLOUD_API_KEY=
# The `cx` from programmablesearchengine.google.com, with "Search the entire web" ON.
SEARCH_ENGINE_ID=

# ---- Gemini (classification + image generation) ----
GEMINI_API_KEY=

# ---- Data (WORKER ONLY — never set these on Vercel) ----
# Railway private-network URLs. They resolve only inside Railway, so Vercel
# physically cannot use them; the web app reaches data through the worker API.
DATABASE_URL=
REDIS_URL=

# ---- Worker API (the only link between Vercel and Railway) ----
# Vercel holds just these three vars plus NEXT_PUBLIC_APP_URL. Postgres and
# Redis stay private; the worker is the single authenticated entry point.
WORKER_API_URL=https://defenex-worker-production.up.railway.app
WORKER_API_SECRET=

# ---- Object storage (screenshots, report PDFs) — Cloudflare R2 ----
CLOUDFLARE_BUCKET_S3_ENDPOINT=
CLOUDFLARE_BUCKET_S3_ACCESS_KEY_ID=
CLOUDFLARE_BUCKET_S3_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_TOKEN=
R2_BUCKET=defenex-assets

# ---- Transactional email (defenex.com ONLY — never cold outreach) ----
RESEND_API_KEY=

# ---- Billing ----
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- App ----
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
SENTRY_DSN=

# ---- Engine tuning ----
# Max search calls per scan (each is one billable API call).
SCAN_QUERY_BUDGET=15
# Results requested per call. Same price at any depth; bounded by latency.
SEARCH_DEPTH=50
# Circuit breaker on calls per day, so scans defer instead of failing.
SEARCH_DAILY_CAP=5000

# ---- Contact discovery (M7) ----
APIFY_API_KEY=

# ---- Cold outreach (M7 — defenex.ca, SEPARATE provider from Resend) ----
# CASL applies: no send without a recorded consent basis.
OUTREACH_API_KEY=
OUTREACH_FROM_DOMAIN=defenex.ca
