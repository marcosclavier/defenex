# ---- Google Custom Search (detection engine) ----
# Requires "Custom Search API" enabled in the Cloud project.
GOOGLE_CLOUD_API_KEY=
# The `cx` from programmablesearchengine.google.com, with "Search the entire web" ON.
SEARCH_ENGINE_ID=

# ---- Gemini (classification + image generation) ----
GEMINI_API_KEY=

# ---- Data ----
DATABASE_URL=
REDIS_URL=

# ---- Object storage (screenshots, report PDFs) — Cloudflare R2 ----
# S3-compatible endpoint: https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_BUCKET_S3_API=
# Credentials come from an R2 API token with Object Read & Write.
# The endpoint alone cannot authenticate — both of these are required.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=defenex-assets

# ---- Transactional email (defenex.com ONLY — never cold outreach) ----
RESEND_API_KEY=

# ---- Billing ----
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- App ----
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
SENTRY_DSN=

# ---- Engine tuning ----
# Max CSE queries per scan.
SCAN_QUERY_BUDGET=20
# Circuit breaker, set below Google's hard 10k/day so we fail soft.
CSE_DAILY_CAP=8000

# ---- Contact discovery (M7) ----
APIFY_API_KEY=

# ---- Cold outreach (M7 — defenex.ca, SEPARATE provider from Resend) ----
# CASL applies: no send without a recorded consent basis.
OUTREACH_API_KEY=
OUTREACH_FROM_DOMAIN=defenex.ca
