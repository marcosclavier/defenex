# ---- Search: YepAPI SERP (primary detection source) ----
# Billed per CALL ($0.01), not per result — depth is nearly free coverage.
YEPAPI_API_KEY=

# ---- Search: Google Custom Search (fallback only) ----
# Google is discontinuing the Custom Search JSON API in January 2027.
# Requires "Custom Search API" enabled in the Cloud project.
GOOGLE_CLOUD_API_KEY=
# The `cx` from programmablesearchengine.google.com, with "Search the entire web" ON.
SEARCH_ENGINE_ID=

# ---- Gemini (classification + image generation) ----
GEMINI_API_KEY=

# ---- Data (WORKER ONLY — never set these on Vercel) ----
# Railway private-network URLs. They resolve only inside Railway, so Vercel
# physically cannot use them; the web app reaches data through the worker API.
DATABASE_URL=
REDIS_URL=

# ---- Worker API (the only link between Vercel and Railway) ----
# Vercel holds just these three vars plus NEXT_PUBLIC_APP_URL. Postgres and
# Redis stay private; the worker is the single authenticated entry point.
WORKER_API_URL=https://defenex-worker-production.up.railway.app
WORKER_API_SECRET=

# ---- Object storage (screenshots, report PDFs) — Cloudflare R2 ----
CLOUDFLARE_BUCKET_S3_ENDPOINT=
CLOUDFLARE_BUCKET_S3_ACCESS_KEY_ID=
CLOUDFLARE_BUCKET_S3_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_TOKEN=
R2_BUCKET=defenex

# ---- Transactional email ----
# The sending domain must be verified in Resend. defenex.ca is verified today;
# defenex.com is not. Keep transactional and cold outreach on separate domains
# so outreach complaints cannot poison report delivery.
RESEND_API_KEY=
RESEND_FROM_DOMAIN=defenex.com

# ---- Billing ----
# Prefer STRIPE_SECRET_KEY with an sk_test_ key while developing; the setup
# script falls back to STRIPE_API_KEY.
STRIPE_SECRET_KEY=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Test-mode key, used by preview/development and by `pnpm stripe:setup --test`.
STRIPE_TEST_API_KEY=
# Created by `pnpm stripe:setup --apply`. Price ids differ between live and
# test mode, so production and preview need different values.
STRIPE_PRICE_MONITOR_MONTHLY=
STRIPE_PRICE_MONITOR_YEARLY=
STRIPE_PRICE_PROTECT_MONTHLY=
STRIPE_PRICE_PROTECT_YEARLY=
STRIPE_PRICE_MANAGED_MONTHLY=
STRIPE_PRICE_MANAGED_YEARLY=
STRIPE_PRICE_ENFORCEMENT_OVERAGE_ONCE=
STRIPE_PRICE_ENFORCEMENT_SINGLE_ONCE=

# ---- App ----
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Error reporting ----
# Separate Sentry projects: the worker reads SENTRY_DSN, the web app needs the
# NEXT_PUBLIC_ form because a bare var never reaches the browser bundle.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Vercel only, for source-map upload. Absent means the upload step is skipped,
# which is what keeps CI green without secrets.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---- Notices (M6) ----
# The identity that appears on filed takedown notices. NOTICE_FROM_EMAIL must be
# a verified Resend sender and must match the contact address inside the notice
# body, or the envelope disagrees with the sworn text.
NOTICE_FROM_EMAIL=notices@defenex.com
NOTICE_ORGANISATION=Defenex
NOTICE_AGENT_TITLE=Brand Protection Agent
NOTICE_AGENT_PHONE=
NOTICE_AGENT_ADDRESS=
# USPTO TSDR, for the advisory rights pre-check. Optional; without it a claim
# goes straight to manual review.
USPTO_API_KEY=

# ---- Paid fetch tier: spider.cloud ----
# Roughly a fortieth of the price of the YepAPI stealth tier and several times
# faster, and it returns page HTML — which is what lets evidence capture
# photograph a site that refuses our own browser.
SPIDER_CLOUD_API_KEY=
# The paid fetch tier: chain | spider | yepapi.
# `chain` tries spider first and falls back to YepAPI where spider was defeated.
# Neither provider wins outright — spider reads DHgate, which YepAPI and our own
# browser both get a 403 from, and costs a fortieth as much; YepAPI reads Etsy,
# which spider gets a consistent 403 from. Pin a single provider only to revert.
SCAN_FETCH_PROVIDER=chain

# ---- Engine tuning ----
# Max search calls per scan (each is one billable API call).
SCAN_QUERY_BUDGET=15
# Results requested per call. Same price at any depth; bounded by latency.
SEARCH_DEPTH=50
# Circuit breaker on calls per day, so scans defer instead of failing.
SEARCH_DAILY_CAP=5000
# Paid stealth calls per scan ($0.03 each), by tier. Anonymous scans get a small
# allowance; identifying yourself unlocks deeper coverage of bot-blocked sites.
STEALTH_BUDGET_ANON=2
STEALTH_BUDGET_IDENTIFIED=8

# ---- Monitoring (M5) ----
# How often the scheduler looks for due rescans, and how many brands one tick
# may enqueue. The batch size caps the spend a single tick can trigger.
SCHEDULE_INTERVAL_MINUTES=60
SCHEDULE_BATCH_SIZE=25

# ---- Contact discovery (M7) ----
APIFY_API_KEY=

# ---- Cold outreach (M7 — defenex.ca, SEPARATE provider from Resend) ----
# CASL applies: no send without a recorded consent basis.
OUTREACH_API_KEY=
OUTREACH_FROM_DOMAIN=defenex.ca
