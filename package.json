{
  "name": "defenex",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "scan": "pnpm --filter @defenex/core scan",
    "db:generate": "pnpm --filter @defenex/db generate",
    "db:migrate": "pnpm --filter @defenex/db migrate",
    "db:studio": "pnpm --filter @defenex/db studio",
    "preflight": "pnpm --filter @defenex/core preflight"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "turbo": "^2.10.9",
    "typescript": "^5.9.0"
  }
}
